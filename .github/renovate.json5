{
  "enabled": true,
  "timezone": "America/Chicago",
  "semanticCommits": "enabled",
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "Renovate Dashboard 🤖",
  "suppressNotifications": ["prIgnoreNotification"],
  "docker": {
    "fileMatch": ["Containerfile"]
  },
  "regexManagers": [
    {
      "fileMatch": [
        "Containerfile",
      ],
      "matchStrings": [
        "https:\/\/github.com\/(?<org>.*=?)\/(?<repo>.*=?)\/releases\/download\/(?<currentValue>.*=?)\/.*"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "{{org}}/{{repo}}"
    }
  ],
  "packageRules": [
    {
      // fedora-toolbox:N+1 is rawhide until Fedora N+1 ships, and renovate
      // cannot tell. Stay on the stable release; bump the base by hand after
      // a release, or approve it from the dashboard. Never the rawhide tag.
      "matchDatasources": ["docker"],
      "matchPackageNames": ["registry.fedoraproject.org/fedora-toolbox"],
      "allowedVersions": "/^[0-9]+$/",
      "dependencyDashboardApproval": true
    }
  ]
}
